@model List<UserManagement.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        
        <!-- Status / Alert Message Container (No browser alerts as requested) -->
        <div id="statusAlertContainer"></div>

        <!-- Toolbar & Filter Area -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <!-- Action Toolbar (Requirement #2 & #4) -->
            <div class="btn-toolbar gap-2" role="toolbar" aria-label="User Management Toolbar">
                <!-- Block Button (with text as per requirement) -->
                <button type="button" id="btnBlock" class="btn btn-warning btn-sm d-flex align-items-center gap-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Block selected users" disabled>
                    <i class="bi bi-lock-fill"></i>
                    <span>Block</span>
                </button>

                <!-- Unblock Button (icon as per requirement) -->
                <button type="button" id="btnUnblock" class="btn btn-outline-success btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Unblock selected users" disabled>
                    <i class="bi bi-unlock-fill"></i>
                </button>

                <!-- Delete Button (icon as per requirement) -->
                <button type="button" id="btnDelete" class="btn btn-outline-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete selected users permanently" disabled>
                    <i class="bi bi-trash-fill"></i>
                </button>

                <!-- Delete Unverified Button (icon as per requirement) -->
                <button type="button" id="btnDeleteUnverified" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete all unverified users">
                    <i class="bi bi-person-x-fill"></i>
                </button>
            </div>

            <!-- Filter / Search box (Shown in screenshot) -->
            <div class="d-flex align-items-center">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="tableFilter" class="form-control border-start-0 ps-0" placeholder="Filter users..." aria-label="Filter" />
                </div>
            </div>
        </div>

        <!-- User Management Table (Requirement #2, #3, #4) -->
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0" id="usersTable">
                <thead class="table-light">
                    <tr>
                        <!-- Leftmost column: Checkbox without label (Select/Deselect All) -->
                        <th style="width: 40px;" class="text-center">
                            <input class="form-check-input" type="checkbox" id="selectAllCheckbox" aria-label="Select all rows" />
                        </th>
                        <th class="sortable-th user-select-none" style="cursor: pointer;" data-col="1">
                            Name <i class="bi bi-arrow-down-up text-muted small ms-1"></i>
                        </th>
                        <th class="sortable-th user-select-none" style="cursor: pointer;" data-col="2">
                            Email <i class="bi bi-arrow-down-up text-muted small ms-1"></i>
                        </th>
                        <th class="sortable-th user-select-none" style="cursor: pointer;" data-col="3">
                            Status <i class="bi bi-arrow-down-up text-muted small ms-1"></i>
                        </th>
                        <th class="sortable-th user-select-none" style="cursor: pointer;" data-col="4">
                            Last Seen <i class="bi bi-arrow-down-up text-muted small ms-1"></i>
                        </th>
                        <th class="sortable-th user-select-none" style="cursor: pointer;" data-col="5">
                            Registered <i class="bi bi-arrow-down-up text-muted small ms-1"></i>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr id="noRecordsRow">
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-people fs-2 d-block mb-2"></i>
                                No users found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            <tr data-user-id="@user.Id" class="@(user.Status == "Blocked" ? "table-secondary text-muted" : "")">
                                <!-- Row Checkbox without label -->
                                <td class="text-center">
                                    <input class="form-check-input user-checkbox" type="checkbox" value="@user.Id" aria-label="Select user @user.Name" />
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@user.Name</div>
                                </td>
                                <td>
                                    <span class="text-muted">@user.Email</span>
                                </td>
                                <td>
                                    @if (user.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i> Active
                                        </span>
                                    }
                                    else if (user.Status == "Unverified")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            <i class="bi bi-clock-history me-1"></i> Unverified
                                        </span>
                                    }
                                    else if (user.Status == "Blocked")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-slash-circle me-1"></i> Blocked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@user.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (user.LastLoginTime.HasValue)
                                    {
                                        <span data-bs-toggle="tooltip" title="@user.LastLoginTime.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC" data-timestamp="@user.LastLoginTime.Value.Ticks">
                                            @user.LastLoginTime.Value.ToString("MMM dd, yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic" data-timestamp="0">Never</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small" data-bs-toggle="tooltip" title="@user.RegistrationTime.ToString("yyyy-MM-dd HH:mm:ss") UTC" data-timestamp="@user.RegistrationTime.Ticks">
                                        @user.RegistrationTime.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/user-management.js" asp-append-version="true"></script>
}
